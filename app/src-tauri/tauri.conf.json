{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Campfire",
  "version": "0.2.0",
  "identifier": "moe.dill.campfire",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Campfire",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "url": "https://campfire.dill.moe",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Campfire — chat + voice for your servers",
    "longDescription": "Native app for Campfire: tray icon, start on login, and automatic game detection with playtime, levels and streaks.",
    "category": "Utility"
  }
}
