{
  "$schema": "../schemas/schema.json",
  "identifier": "default",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "opener:default",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-start-minimized",
    "allow-set-start-minimized",
    "allow-set-unread-count",
    "allow-notify",
    "allow-get-running-games",
    "allow-get-overlay-settings",
    "allow-set-overlay-settings",
    "allow-overlay-state",
    "allow-overlay-update",
    "allow-open-external"
  ],
  "remote": {
    "urls": ["https://campfire.dill.moe"]
  }
}
