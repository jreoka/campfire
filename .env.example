# Copy to .env and fill in.
# Local dev:  docker compose up -d --build
# Production: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
PORT=3000
JWT_SECRET=change-me-to-something-long-and-random

# Postgres 18 (docker-compose db service). Alphanumeric password keeps
# compose interpolation happy; or set DATABASE_URL instead of the PG* lines.
POSTGRES_DB=campfire
POSTGRES_USER=campfire
POSTGRES_PASSWORD=change-me-to-something-long-and-alphanumeric

# Local dev binds everywhere; production should bind loopback only (Caddy proxies in).
# BIND=127.0.0.1

# Production only (with docker-compose.prod.yml): public domain for automatic HTTPS.
# DOMAIN=chat.example.com

# Optional: Klipy GIF search (get a key at https://klipy.com/api-overview).
# The key stays server-side — the browser talks to /api/gifs/*, never to Klipy.
# KLIPY_KEY=paste-key-here

# Link previews (unfurl). The client embeds YouTube/Spotify/X/etc. itself;
# everything else (HuggingFace model pages, articles, docs...) is fetched by
# the SERVER and reduced to a card: site, title, description, thumbnail.
# Only OpenGraph/Twitter-card/oEmbed metadata is read — never sent anywhere
# else — and each URL is fetched once, then cached in Postgres for a week.
# Private/loopback/link-local addresses are refused on every hop, thumbnails
# are re-served from /api/unfurl/img behind an HMAC signature, and only real
# image bytes (sniffed, SVG refused) are ever returned from our origin.
# UNFURL=0 hides previews (client stops asking too; /api/config carries it).
# UNFURL_TIMEOUT_MS=8000
# UNFURL_MAX_HTML=524288
# UNFURL_MAX_IMAGE=8388608
# UNFURL_CONCURRENCY=4
# UNFURL_IMG_CACHE_MB=24

# Cloudflare Turnstile captcha for login/signup. Get keys at
# https://dash.cloudflare.com/?to=/:account/turnstile. The site key is
# public (served via /api/config); the secret stays server-side.
# When unset, captcha verification is skipped (local dev).
# TURNSTILE_SITEKEY=paste-site-key-here
# TURNSTILE_SECRET=paste-secret-key-here

# Optional push notifications (Web Push). If unset, the server generates and
# stores VAPID keys itself on first boot — nothing to configure.
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# PUSH_SUBJECT=mailto:admin@example.com

# Chat attachments (images, video, etc.) cap at 200MB by default.
# MAX_FILE_MB=200

# Background media compressor (images/GIFs/video/audio in chat uploads).
# It is NOT part of the upload path: a file is served the moment it lands and
# nothing about it waits for an encode. Two triggers, split by what the encode is
# for:
#   - the COMPATIBILITY QUEUE, for bytes a reader's platform cannot open at all
#     (Opus/Vorbis audio -> AAC/MP4, non-MP4 video -> MP4, HEIC/HEIF -> JPEG).
#     These are repairs, not size policies, so they are settled seconds after the
#     upload lands. It runs continuously while it has work (files per tick with a
#     short MEDIA_COMPRESS_ACTIVE_MS breather, single ffmpeg thread each at the
#     lowest CPU priority, deferred when the box is busy) and falls back to a
#     MEDIA_COMPRESS_EVERY_MS idle poll; an upload wakes it within a second.
#   - the SCHEDULED BUCKET SWEEP below, for everything else: the ordinary
#     shrinking of media every reader can already open, hours later, when nobody
#     is looking at the file.
# Quality is visually transparent (still images capped at 2048px, GIFs at
# 1280px/20fps, video at 1080p CRF 24, audio at 128-192k) and files that
# would shrink <8% keep their original bytes. Requires ffmpeg on PATH
# (the Docker image already includes it).
# Every size and every type the box can decode is attempted — BMP/TIFF/AVIF/
# JXL/HEIC/ICO included, alpha-aware, any video/audio container normalised to
# MP4/MP3/AAC, and a PNG re-encoded as WebP q82 (lossy; transparency kept)
# when libwebp is present; only non-media (pdf, zip, source) and SVG are left
# alone.
# MEDIA_COMPRESS=1
# MEDIA_COMPRESS_ACTIVE_MS=2000
# MEDIA_COMPRESS_EVERY_MS=30000
# MEDIA_COMPRESS_BATCH=1            # files fed to one tick (max 16)
# MEDIA_COMPRESS_CONCURRENCY=1      # encodes at once, process-wide (max 4)
# MEDIA_COMPRESS_SLOT_MB=192        # free memory each encode past the first
#                                   # must find first (needs a cgroup to read)
# MEDIA_COMPRESS_MIN_KB=0          # flat size floor; 0 (default) = no floor
#
# Bucket reconciliation: this is the compression path for ordinary media. It
# lists the bucket on a timer and compresses what it finds — referenced, above
# the size floor, and not already in the key ledger (media_compress_keys, which
# is what keeps a second pass from re-encoding bytes it already handled). That
# covers chat/DM attachments and stories (whose rows carry a `compressed` flag)
# as well as profile media (avatars, banners, server icons, custom emoji), which
# has no flag at all. Unreferenced objects are left to the orphan sweep; an
# object only a pasted link mentions is reported rather than repointed. The
# result is published under a NEW key with every row that points at it repointed,
# so bytes behind a live URL are never rewritten under a reader.
# MEDIA_BUCKET_SWEEP=1
# MEDIA_SWEEP_EVERY_MS=21600000   # 6h between passes (min 10min)
# MEDIA_SWEEP_FIRST_MS=600000     # first pass after boot (min 30s)
# MEDIA_SWEEP_MIN_AGE_MS=600000   # leave a file the reader was just handed alone
# MEDIA_SWEEP_MAX_JOBS=100        # compressions per pass
# MEDIA_SWEEP_MAX_MS=1200000      # 20min time budget per pass
# MEDIA_SWEEP_MAX_PAGES=100       # bucket listing pages (1000 objects each)

# Optional S3-compatible media storage (e.g. Cloudflare R2). When all four
# are set, uploads go to the bucket and /uploads/* is served from it;
# otherwise files stay on local disk next to the DB. URLs never change, so
# you can migrate back and forth with scripts/migrate-uploads-to-r2.js.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=campfire
# S3_REGION=auto
# S3_ACCESS_KEY=paste-key-here
# S3_SECRET_KEY=paste-secret-here

# Automatic database backups (only when S3_* above are set): gzipped
# snapshots uploaded to the top-level backups/ folder at 00:00 and 12:00
# server-local time, keeping the newest BACKUP_KEEP dumps. The backups/
# prefix is never served over HTTP, so dump URLs can't be guessed.
# BACKUP_KEEP=10

# Virus scanning for every upload, by content (renaming malware.exe to
# photo.jpg does not fool it). The engine is ClamAV, in its own container (the
# `clamav` service in docker-compose.yml): a signature engine needs a database
# on disk, a downloader on a schedule (freshclam, which the image runs) and a
# daemon holding the database in RAM, so none of that belongs in the app's image
# or process. The app streams each upload to clamd over TCP (`INSTREAM`), so the
# two containers share no volume and the daemon never sees a path in this one.
# The verdict is a BACKGROUND judgement: the upload posts to chat and is served
# the moment it lands, and a detection is what removes it — the bytes are
# deleted at once, the message stays up with a greyed-out virus warning and no
# download link, and the reader can open "Scan info" on it to see the signature
# ClamAV matched. Nothing about an upload waits for a scan or for an encode: the
# old scan -> compress -> scan slot (and its "Processing file" card) is gone.
# Without a working daemon (local dev, a database that failed to load) uploads
# fail OPEN as clean with a loud log line, and nothing is queued to judge at all.
# The admin panel shows the engine generation, the signature revision and its date.
# VIRUS_SCAN=1
# Where clamd is. In Docker this is the compose service name; outside Docker
# point it at a local daemon.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# Startup probe: it scans the EICAR test string and REFUSES a daemon that does
# not detect it — a ClamAV whose database failed to load answers OK to
# everything, which is worse than no scanner because it is believed. The image
# sets this to 1 already; a test stand-in turns it off.
# CLAMAV_VERIFY_EICAR=1
# Base per-file scan timeout, plus the file's own size (capped at 10 minutes).
# CLAMAV_TIMEOUT_MS=120000
# Parallel scan slots (default 3, max 10): concurrent uploads each get a verdict
# without head-of-line blocking behind one big file. Each slot streams one file
# to the daemon; the daemon's own MaxThreads is the ceiling (see
# CLAMD_CONF_MaxThreads below).
# VIRUS_SCAN_CONCURRENCY=3
#
# The scanner container's own knobs live in docker-compose.yml as CLAMD_CONF_* /
# FRESHCLAM_CONF_* (the image's entrypoint writes them into clamd.conf and
# freshclam.conf). The ones that matter here:
#   CLAMD_CONF_StreamMaxLength  must clear MAX_FILE_MB, or a big upload is
#                               refused by the daemon instead of judged
#   CLAMD_CONF_MaxFileSize      the per-file cap, including inside archives
#   CLAMD_CONF_MaxScanSize      the total one scan may expand to
#   CLAMD_CONF_MaxThreads       how many scans the daemon serves at once
#   FRESHCLAM_CONF_Checks       signature updates per day (24 = hourly)
# The image tag: `latest` is the current stable ClamAV release (the versioned
# tags — 1.5, 1.4 — are that same build, frozen). It floats on purpose, because
# fresh signatures are only half of a signature engine: deploy/ovh/update-images.sh
# (arm it with deploy/ovh/systemd/campfire-images.timer) pulls the scanner
# forward unattended, verifies it with the acceptance check below, rolls the
# previous image back when that fails, and restarts the app so the engine
# generation every verdict is recorded against is re-probed. Set this to freeze
# the engine, which is also how you hold a release you do not want.
# CLAMAV_TAG=latest
# `docker compose exec campfire node scripts/verify-clamav.js` is the acceptance
# check against the real daemon: EICAR detected, a harmless body clear, a 50 MB
# body accepted and scanned, and the signature database's age.
#
# Whole-bucket scan. The upload path only ever judges what it just received, so
# anything stored while scanning was off — or judged by an EARLIER engine (the
# machine-learned detector this app used before ClamAV) — has no verdict from the
# engine running now, and the /uploads gate serves an unknown key. This worker
# closes that hole on a schedule: it lists the stored tree and queues the keys
# the current engine generation has not judged. A key it has already judged is
# never re-queued (the row is the ledger). Upgrading ClamAV is therefore a
# full re-verification of the stored tree, with no migration to run; a daily
# signature bump is deliberately not, or every snapshot of new signatures would
# re-scan the whole bucket.
# `backups/` (database dumps) and `thumbs/` (derived previews) are never listed.
# The admin console's Media tab can dry-run it ("Check scan coverage") and kick
# it by hand ("Scan bucket now").
# BUCKET_SCAN=1
# BUCKET_SCAN_EVERY_MS=86400000   # period between passes (min 10min)
# BUCKET_SCAN_FIRST_MS=600000     # delay before the first pass (min 30s)
# BUCKET_SCAN_MAX_JOBS=200        # objects adopted per pass (max 5000)
# BUCKET_SCAN_MAX_PAGES=100       # bucket listing pages per pass
#
# VIRUS_SCAN=0 turns the scanner off entirely: there are no verdicts and nothing
# is queued to judge, so every upload is served as it lands, unscanned (see
# virus-scan.js). Compression is unaffected — it is a separate, background
# concern (media-compress.js).
# VIRUS_SCAN=0

# Orphaned-upload sweep: files nothing references (deleted messages,
# uploads never attached, pre-S3 leftovers) are deleted every 24h once
# older than ORPHAN_GRACE_H. The top-level backups/ prefix is never
# listed, so database dumps can't be touched.
# ORPHAN_SWEEP=1
# ORPHAN_GRACE_H=48

# Where uploaded files live. In Docker this MUST be on the mounted volume
# (docker-compose.yml mounts ./data at /data) or uploads land in the image
# layer and vanish on every rebuild. Outside Docker the default is
# ./data/uploads.
# UPLOAD_DIR=/data/uploads

# Optional voice (WebRTC) helpers — defaults work on LAN and most home internet.
# For strict NATs / CGNAT across the internet, provision coturn on the server:
#   ssh root@YOUR-HOST bash -s < scripts/setup-turn.sh
# then set the TURN_* lines it writes (STUN stays as-is):
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=campfire
# TURN_PASS=change-me
