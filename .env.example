# Copy to .env and fill in.
# Local dev:  docker compose up -d --build
# Production: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
PORT=3000
JWT_SECRET=change-me-to-something-long-and-random

# Postgres 18 (docker-compose db service). Alphanumeric password keeps
# compose interpolation happy; or set DATABASE_URL instead of the PG* lines.
POSTGRES_DB=campfire
POSTGRES_USER=campfire
POSTGRES_PASSWORD=change-me-to-something-long-and-alphanumeric

# Local dev binds everywhere; production should bind loopback only (Caddy proxies in).
# BIND=127.0.0.1

# Production only (with docker-compose.prod.yml): public domain for automatic HTTPS.
# DOMAIN=chat.example.com

# Optional: Klipy GIF search (get a key at https://klipy.com/api-overview).
# The key stays server-side — the browser talks to /api/gifs/*, never to Klipy.
# KLIPY_KEY=paste-key-here

# Link previews (unfurl). The client embeds YouTube/Spotify/X/etc. itself;
# everything else (HuggingFace model pages, articles, docs...) is fetched by
# the SERVER and reduced to a card: site, title, description, thumbnail.
# Only OpenGraph/Twitter-card/oEmbed metadata is read — never sent anywhere
# else — and each URL is fetched once, then cached in Postgres for a week.
# Private/loopback/link-local addresses are refused on every hop, thumbnails
# are re-served from /api/unfurl/img behind an HMAC signature, and only real
# image bytes (sniffed, SVG refused) are ever returned from our origin.
# UNFURL=0 hides previews (client stops asking too; /api/config carries it).
# UNFURL_TIMEOUT_MS=8000
# UNFURL_MAX_HTML=524288
# UNFURL_MAX_IMAGE=8388608
# UNFURL_CONCURRENCY=4
# UNFURL_IMG_CACHE_MB=24

# Cloudflare Turnstile captcha for login/signup. Get keys at
# https://dash.cloudflare.com/?to=/:account/turnstile. The site key is
# public (served via /api/config); the secret stays server-side.
# When unset, captcha verification is skipped (local dev).
# TURNSTILE_SITEKEY=paste-site-key-here
# TURNSTILE_SECRET=paste-secret-key-here

# Optional push notifications (Web Push). If unset, the server generates and
# stores VAPID keys itself on first boot — nothing to configure.
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# PUSH_SUBJECT=mailto:admin@example.com

# Chat attachments (images, video, etc.) cap at 200MB by default.
# MAX_FILE_MB=200

# Background media compressor (images/GIFs/video/audio in chat uploads).
# Runs in-process and continuously while files are queued: files per tick with a
# short MEDIA_COMPRESS_ACTIVE_MS breather between ticks, single ffmpeg thread
# each at the lowest CPU priority, deferred when the box is busy. Once the
# queue drains it falls back to a MEDIA_COMPRESS_EVERY_MS idle poll, and new
# uploads wake it within a second.
# Quality is visually transparent (still images capped at 2048px, GIFs at
# 1280px/20fps, video at 1080p CRF 24, audio at 128-192k) and files that
# would shrink <8% keep their original bytes. Requires ffmpeg on PATH
# (the Docker image already includes it).
# Every size and every type the box can decode is attempted — BMP/TIFF/AVIF/
# JXL/HEIC/ICO included, alpha-aware, and any video/audio container normalised
# to MP4/MP3/AAC; only non-media (pdf, zip, source) and SVG are left alone.
# MEDIA_COMPRESS=1
# MEDIA_COMPRESS_ACTIVE_MS=2000
# MEDIA_COMPRESS_EVERY_MS=30000
# MEDIA_COMPRESS_BATCH=1            # files fed to one tick (max 16)
# MEDIA_COMPRESS_CONCURRENCY=1      # encodes at once, process-wide (max 4)
# MEDIA_COMPRESS_SLOT_MB=192        # free memory each encode past the first
#                                   # must find first (needs a cgroup to read)
# MEDIA_COMPRESS_MIN_KB=0          # flat size floor; 0 (default) = no floor
#
# Bucket reconciliation: the queue above is flag-driven, which covers chat/DM
# attachments and stories — profile media (avatars, banners, server icons,
# custom emoji), a pasted /uploads/ link, and anything an older build left
# behind are invisible to it. So a scheduled pass lists the bucket and adopts
# what it finds: referenced, above the size floor, and not already in the
# key ledger (media_compress_keys, which is what keeps a second pass from
# re-encoding bytes that are already compressed). Unreferenced objects are
# left to the orphan sweep; an object only a pasted link mentions is reported
# rather than repointed. A profile upload also kicks its own key, so a new
# avatar is settled within a second or two.
# MEDIA_BUCKET_SWEEP=1
# MEDIA_SWEEP_EVERY_MS=21600000   # 6h between passes (min 10min)
# MEDIA_SWEEP_FIRST_MS=600000     # first pass after boot (min 30s)
# MEDIA_SWEEP_MIN_AGE_MS=600000   # leave brand-new objects to the upload path
# MEDIA_SWEEP_MAX_JOBS=100        # compressions per pass
# MEDIA_SWEEP_MAX_MS=1200000      # 20min time budget per pass
# MEDIA_SWEEP_MAX_PAGES=100       # bucket listing pages (1000 objects each)

# Optional S3-compatible media storage (e.g. Cloudflare R2). When all four
# are set, uploads go to the bucket and /uploads/* is served from it;
# otherwise files stay on local disk next to the DB. URLs never change, so
# you can migrate back and forth with scripts/migrate-uploads-to-r2.js.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=campfire
# S3_REGION=auto
# S3_ACCESS_KEY=paste-key-here
# S3_SECRET_KEY=paste-secret-here

# Automatic database backups (only when S3_* above are set): gzipped
# snapshots uploaded to the top-level backups/ folder at 00:00 and 12:00
# server-local time, keeping the newest BACKUP_KEEP dumps. The backups/
# prefix is never served over HTTP, so dump URLs can't be guessed.
# BACKUP_KEEP=10

# Virus scanning for every upload (ClamAV, content-based — renaming
# malware.exe to photo.jpg does not fool it). Uploads post to chat
# immediately but chat files stay unservable until the verdict lands:
# senders and viewers see an animated "Processing" card, then the real
# file. Infected bytes are deleted at
# once; the message stays up with a greyed-out virus warning and no
# download link. Needs ~1GB RAM for clamd plus ~500MB in CLAM_DB_DIR
# for signatures (one-time download on first boot, persisted on the
# volume). Without working AV (local dev) uploads fail OPEN as clean
# with a loud log line — never wedged. Admin panel shows engine state.
# VIRUS_SCAN=1
# CLAM_DB_DIR=/data/clamav
# CLAM_PORT=3310
# Parallel scan slots (default 3, max 10): concurrent uploads each get a
# verdict without head-of-line blocking behind one big file.
# VIRUS_SCAN_CONCURRENCY=3
#
# VIRUS_SCAN=0 turns the scanner off but NOT the slot: with
# MEDIA_COMPRESS left on, the same worker compresses each upload before it
# can be served (see media-compress.js). Callers still see one
# "Processing file" -> final transition, and a file the compressor would
# never rewrite is served the instant it lands. Use 1 scan slot on a small
# node — S3 mode buffers each download in RAM.
# VIRUS_SCAN=0
# VIRUS_SCAN_CONCURRENCY=1

# Orphaned-upload sweep: files nothing references (deleted messages,
# uploads never attached, pre-S3 leftovers) are deleted every 24h once
# older than ORPHAN_GRACE_H. The top-level backups/ prefix is never
# listed, so database dumps can't be touched.
# ORPHAN_SWEEP=1
# ORPHAN_GRACE_H=48

# Where uploaded files live. In Docker this MUST be on the mounted volume
# (docker-compose.yml mounts ./data at /data) or uploads land in the image
# layer and vanish on every rebuild. Outside Docker the default is
# ./data/uploads.
# UPLOAD_DIR=/data/uploads

# Optional voice (WebRTC) helpers — defaults work on LAN and most home internet.
# For strict NATs / CGNAT across the internet, provision coturn on the server:
#   ssh root@YOUR-HOST bash -s < scripts/setup-turn.sh
# then set the TURN_* lines it writes (STUN stays as-is):
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=campfire
# TURN_PASS=change-me
