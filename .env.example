# Copy to .env and fill in.
# Local dev:  docker compose up -d --build
# Production: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
PORT=3000
JWT_SECRET=change-me-to-something-long-and-random

# Local dev binds everywhere; production should bind loopback only (Caddy proxies in).
# BIND=127.0.0.1

# Production only (with docker-compose.prod.yml): public domain for automatic HTTPS.
# DOMAIN=chat.example.com

# Optional voice (WebRTC) helpers — defaults work on LAN.
# For voice across the internet behind NAT, set up coturn and uncomment:
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=campfire
# TURN_PASS=change-me
