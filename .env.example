# Copy to .env and fill in.
# Local dev:  docker compose up -d --build
# Production: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
PORT=3000
JWT_SECRET=change-me-to-something-long-and-random

# Postgres 18 (docker-compose db service). Alphanumeric password keeps
# compose interpolation happy; or set DATABASE_URL instead of the PG* lines.
POSTGRES_DB=campfire
POSTGRES_USER=campfire
POSTGRES_PASSWORD=change-me-to-something-long-and-alphanumeric

# Local dev binds everywhere; production should bind loopback only (Caddy proxies in).
# BIND=127.0.0.1

# Production only (with docker-compose.prod.yml): public domain for automatic HTTPS.
# DOMAIN=chat.example.com

# Optional: Klipy GIF search (get a key at https://klipy.com/api-overview).
# The key stays server-side — the browser talks to /api/gifs/*, never to Klipy.
# KLIPY_KEY=paste-key-here

# Cloudflare Turnstile captcha for login/signup. Get keys at
# https://dash.cloudflare.com/?to=/:account/turnstile. The site key is
# public (served via /api/config); the secret stays server-side.
# When unset, captcha verification is skipped (local dev).
# TURNSTILE_SITEKEY=paste-site-key-here
# TURNSTILE_SECRET=paste-secret-key-here

# Optional push notifications (Web Push). If unset, the server generates and
# stores VAPID keys itself on first boot — nothing to configure.
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# PUSH_SUBJECT=mailto:admin@example.com

# Chat attachments (images, video, etc.) cap at 100MB by default.
# MAX_FILE_MB=100

# Background media compressor (images/GIFs/video/audio in chat uploads).
# Runs in-process and continuously while files are queued: one file per tick
# with a short MEDIA_COMPRESS_ACTIVE_MS breather between ticks, single ffmpeg
# thread at the lowest CPU priority, deferred when the box is busy. Once the
# queue drains it falls back to a MEDIA_COMPRESS_EVERY_MS idle poll, and new
# uploads wake it within a second.
# Quality is visually transparent (still images capped at 2048px, GIFs at
# 1280px/20fps, video at 1080p CRF 24, audio at 128-192k) and files that
# would shrink <8% keep their original bytes. Requires ffmpeg on PATH
# (the Docker image already includes it).
# MEDIA_COMPRESS=1
# MEDIA_COMPRESS_ACTIVE_MS=2000
# MEDIA_COMPRESS_EVERY_MS=30000
# MEDIA_COMPRESS_BATCH=1

# Optional S3-compatible media storage (e.g. Cloudflare R2). When all four
# are set, uploads go to the bucket and /uploads/* is served from it;
# otherwise files stay on local disk next to the DB. URLs never change, so
# you can migrate back and forth with scripts/migrate-uploads-to-r2.js.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=campfire
# S3_REGION=auto
# S3_ACCESS_KEY=paste-key-here
# S3_SECRET_KEY=paste-secret-here

# Automatic database backups (only when S3_* above are set): gzipped
# snapshots uploaded to the top-level backups/ folder at 00:00 and 12:00
# server-local time, keeping the newest BACKUP_KEEP dumps. The backups/
# prefix is never served over HTTP, so dump URLs can't be guessed.
# BACKUP_KEEP=10

# Optional voice (WebRTC) helpers — defaults work on LAN and most home internet.
# For strict NATs / CGNAT across the internet, provision coturn on the server:
#   ssh root@YOUR-HOST bash -s < scripts/setup-turn.sh
# then set the TURN_* lines it writes (STUN stays as-is):
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=campfire
# TURN_PASS=change-me
