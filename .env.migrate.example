# Credentials for scripts/migrate-civo-to-r2.js
#
# Copy this file to .env.migrate (gitignored) and fill it in. The migration
# script reads it automatically; nothing here belongs in a shell history, a
# chat transcript, or the repo.
#
# source = the Civo object store the app serves from today (campfire-s3 Secret)
# dest   = the R2 bucket that will replace it
#
# Civo object store credentials are per-region (see the Civo dashboard ->
# Object Stores -> your store -> Connections). The endpoint carries the region:
#   https://objectstore.nyc1.civo.com
SRC_ENDPOINT=https://objectstore.nyc1.civo.com
SRC_REGION=nyc1
SRC_BUCKET=campfire
SRC_ACCESS_KEY=
SRC_SECRET_KEY=
#
# R2 endpoint is always https://<ACCOUNT_ID>.r2.cloudflarestorage.com and the
# region is literally "auto". The access key / secret come from an R2 API token
# with "Object Read & Write" scoped to the destination bucket.
DST_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
DST_REGION=auto
DST_BUCKET=campfire-media
DST_ACCESS_KEY=
DST_SECRET_KEY=
